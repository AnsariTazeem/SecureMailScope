# Default-deny context: only backend build inputs are admitted.
**
!Dockerfile
!.dockerignore
!pyproject.toml
!uv.lock
!README.md
!.python-version
!src/
!src/**

# Re-exclude sensitive or generated files even if accidentally placed under src/.
**/.git
**/.git/**
**/.venv
**/venv
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/.coverage*
**/coverage*
**/htmlcov
**/*.db
**/*.db-*
**/*.sqlite*
**/*.pcap
**/*.pcapng
**/*.cap
**/.env*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*keylog*
**/*credentials*
**/*secrets*
**/id_rsa*
**/id_ed25519*
**/.aws
**/.ssh
**/.vscode
**/.idea
**/build
**/dist
**/*.egg-info
**/node_modules
**/.next
**/web
**/fixtures
**/storage
**/jobs
